{
  "id": "devin-cli",
  "name": "Devin CLI",
  "description": "Run Cognition's Devin CLI as an OpenClaw inference backend",
  "categories": ["agent-runtimes"],
  "enabledByDefault": true,
  "cliBackends": ["devin-cli"],
  "providers": ["devin-cli"],
  "syntheticAuthRefs": ["devin-cli"],
  "nonSecretAuthMarkers": ["openclaw:devin-cli-native-auth"],
  "sessionRouteStateOwners": [
    {
      "id": "devin-cli",
      "label": "Devin CLI",
      "providerIds": ["devin-cli"],
      "runtimeIds": ["devin-cli"],
      "cliSessionKeys": ["devin-cli"],
      "authProfilePrefixes": ["devin-cli:"]
    }
  ],
  "providerCatalogEntry": "./dist/provider-discovery.js",
  "modelCatalog": {
    "providers": {
      "devin-cli": {
        "defaultModel": "adaptive",
        "models": [
          { "id": "adaptive", "name": "Adaptive", "input": ["text"] },
          { "id": "swe-2", "name": "SWE-2", "input": ["text"] },
          { "id": "claude-sonnet-5", "name": "Claude Sonnet 5", "input": ["text"] },
          { "id": "claude-opus-5-5", "name": "Claude Opus 5.5", "input": ["text"] },
          { "id": "gpt-6-astra", "name": "GPT-6 Astra", "input": ["text"] },
          { "id": "kimi-k3", "name": "Kimi K3", "input": ["text"] },
          { "id": "deepseek-v4-1-flash", "name": "DeepSeek V4.1 Flash", "input": ["text"] }
        ]
      }
    },
    "discovery": { "devin-cli": "runtime" }
  },
  "setup": {
    "cliBackends": ["devin-cli"],
    "requiresRuntime": false
  },
  "activation": {
    "onStartup": false
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "command": {
        "type": "string",
        "description": "devin binary name or absolute path (default: 'devin' resolved on PATH)"
      },
      "permissionMode": {
        "type": "string",
        "enum": ["auto", "accept-edits", "smart", "dangerous"],
        "description": "Devin CLI --permission-mode. Default: 'smart'; 'dangerous' when OpenClaw exec policy is full."
      },
      "modelAliases": {
        "type": "object",
        "additionalProperties": { "type": "string" },
        "description": "Extra OpenClaw model ids mapped to `devin --model` ids (merged over built-in aliases)."
      },
      "autoReasoningFamilies": {
        "type": "boolean",
        "description": "Collapse Devin's `<family>-<effort>` variants into one model per family and pick the variant from OpenClaw's thinking level. Default: true."
      },
      "reasoningFamilies": {
        "type": "object",
        "description": "OpenClaw model id -> thinking level -> `devin --model` id. Overrides auto-derived families with the same id.",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            { "required": ["base"] },
            { "required": ["levels"], "properties": { "levels": { "minProperties": 1 } } }
          ],
          "properties": {
            "label": { "type": "string" },
            "levels": {
              "type": "object",
              "propertyNames": { "enum": ["off", "none", "minimal", "low", "medium", "high", "xhigh", "max"] },
              "minProperties": 1,
              "additionalProperties": { "type": "string" }
            },
            "fastLevels": {
              "type": "object",
              "propertyNames": { "enum": ["off", "none", "minimal", "low", "medium", "high", "xhigh", "max"] },
              "additionalProperties": { "type": "string" }
            },
            "base": { "type": "string", "minLength": 1, "description": "Variant used when no thinking level is set or the level is unmapped." },
            "defaultLevel": { "type": "string", "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"] },
            "aliases": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
